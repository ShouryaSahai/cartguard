# CartGuard — copy to .env and fill in. .env is gitignored; this file is safe to commit.

# PayPal sandbox: developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Channel3: trychannel3.com/dashboard -> create API key (free tier)
CHANNEL3_API_KEY=

# LLM: Google Gemini free tier — aistudio.google.com/apikey (no card needed).
# Official OpenAI-compatible endpoint; works with the `openai` npm SDK.
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# Alternative: Z.ai (GLM) pay-per-token — set LLM_BASE_URL=https://api.z.ai/api/paas/v4/ and LLM_MODEL=glm-5.3-flash
# ZAI_API_KEY=

# Admin token required by PUT /policy (send as x-admin-token header). Generate: openssl rand -hex 24
GATE_API_KEY=
ADMIN_TOKEN=
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
